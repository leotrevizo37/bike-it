<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bikeit</groupId>
        <artifactId>bike-it-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>platform-api</artifactId>
    <name>platform-api</name>
    <description>Main Spring Boot entrypoint for the backend.</description>

    <dependencies>
        <dependency>
            <groupId>com.bikeit</groupId>
            <artifactId>shared-kernel</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.bikeit</groupId>
            <artifactId>identity</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.bikeit</groupId>
            <artifactId>commute-profile</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.bikeit</groupId>
            <artifactId>weather</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.bikeit</groupId>
            <artifactId>traffic</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.bikeit</groupId>
            <artifactId>incident-events</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.bikeit</groupId>
            <artifactId>trip-history</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.bikeit</groupId>
            <artifactId>tracking</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.bikeit</groupId>
            <artifactId>recommendation</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
